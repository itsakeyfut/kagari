    colors: {
        Surface: "slate-900",
        SurfaceRaised: "slate-800",
        SurfaceOverlay: "slate-800",
        Bg: "slate-950",
        Text: "slate-50",
        TextMuted: "slate-400",
        TextSubtle: "slate-500",
        Border: "slate-700",
        BorderStrong: "slate-600",
        Accent: "blue-400",
        AccentFg: "slate-950",
        Danger: "red-400",
        Warning: "amber-400",
        Success: "green-400",
        Info: "sky-400",
        FocusRing: "blue-400",
    },
)
